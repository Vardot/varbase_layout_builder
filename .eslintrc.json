{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "node": true,
    "jquery": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "ignorePatterns": [
    "node_modules/**",
    "tests/**",
    "cucumber.js",
    "playwright.config.ts",
    "**/*.es6.js",
    "**/*.yml",
    "**/*.yaml"
  ]
}
