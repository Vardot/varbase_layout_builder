{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "globals": {
    "Drupal": true,
    "drupalSettings": true,
    "jQuery": true,
    "once": true,
    "Sortable": true
  },
  "ignorePatterns": [
    "node_modules/**",
    "themes/**",
    "js/plugins/**",
    "webpack.config*.js",
    "tests/**",
    "cucumber.js",
    "playwright.config.ts",
    "**/*.yml",
    "**/*.yaml"
  ]
}
