# Ignore node modules
node_modules
/*/node_modules

# Ignore Variables
/css/variables.css
/css/mixins/

# Ignore vim swp files and gedit temp files
*.swp
*.*~
.vim

# Ignore Yarn
.yarn/*


# Eclipse settings files.
.project
.pydevproject
.settings
.buildpath

# netbeans settings files.
nbproject
/nbproject
/nbproject/
/nbproject/private/

# Ignore OS settings files.
.DS_Store*
Thumbs.db
ehthumbs.db

# Ignore files generated by PhpStorm.
.idea

# Ignore server stuff.
.bash_history
.bashrc
errors.log
yarn.lock

# Ignore local gitlab-ci-local runner artifacts.
.gitlab-ci-local/

# Ignore webship-js generated test artifacts (reports/screenshots/videos).
/tests/reports/*
!/tests/reports/.gitkeep
/tests/screenshots/*
!/tests/screenshots/.gitkeep
/tests/videos/*
!/tests/videos/.gitkeep
