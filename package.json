{
  "name": "varbase_layout_builder",
  "description": "Provides default configuration and enhancements to utilize Drupal core''s Layout Builder.",
  "private": true,
  "engines": {
    "yarn": ">= 4.9.3",
    "node": ">= 20.0"
  },
  "scripts": {
    "theme:build": "webpack --progress --config webpack.config.build.js && prettier --write \"css/**/*.css\" && stylelint \"css/**/*.css\" --fix",
    "theme:watch": "webpack --progress --config webpack.config.dev.js --watch",
    "claro:build": "webpack --progress --config webpack.config.build.claro.js",
    "gin:build": "webpack --progress --config webpack.config.build.gin.js",
    "plugins:build": "webpack --progress --config webpack.config.build.plugins.js && prettier --write \"css/plugins/**/*.css\" && stylelint \"css/plugins/**/*.css\" --fix",
    "theme:full-build": "yarn theme:build ; yarn plugins:build",
    "phpcs": "phpcs --standard=./.phpcs.xml .",
    "phpcbf": "phpcbf --standard=./.phpcs.xml .",
    "lint:js": "node ./node_modules/eslint/bin/eslint.js .",
    "lint:css": "stylelint \"**/*.css\" \"!themes/**\"",
    "lint:yaml": "node ./node_modules/eslint/bin/eslint.js --ext .yml .",
    "spellcheck": "cspell lint ."
  },
  "author": "Vardot",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "SASS",
    "Bootstrap",
    "Bootstrap Layout Builder",
    "Bootstrap Styles",
    "Drupal",
    "Varbase",
    "Varbase Layout Builder"
  ],
  "devDependencies": {
    "@fortawesome/fontawesome-free": "~5",
    "@popperjs/core": "~2",
    "bootstrap": "~5",
    "bootstrap-borders-utilities": "~1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^12.0.2",
    "core-js": "^3.39.0",
    "cspell": "^8.16.1",
    "css-loader": "^7.1.2",
    "dotenv-safe": "^8.2.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jquery": "^1.5.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-yml": "^1.15.0",
    "expose-loader": "^5.0.0",
    "file-loader": "^6.2.0",
    "glob": "^11.0.0",
    "img-loader": "^4.0.0",
    "jquery": "~3.7.0",
    "jquery-form": "4.3.x",
    "jquery-ui": "1.13.x",
    "js-cookie": "3.0.x",
    "jsdom": "^25.0.1",
    "loadjs": "4.2.x",
    "mini-css-extract-plugin": "^2.9.2",
    "minimist": "^1.2.8",
    "mkdirp": "^1.0.4",
    "nightwatch": "^3.9.1",
    "normalize.css": "8.0.x",
    "postcss": "^8.5.10",
    "postcss-header": "^3.0.3",
    "postcss-import": "^16.1.0",
    "postcss-loader": "^8.1.1",
    "postcss-preset-env": "^10.1.3",
    "postcss-pxtorem": "^6.1.0",
    "postcss-rtlcss": "^5.5.0",
    "postcss-url": "^10.1.3",
    "prettier": "^3.4.2",
    "raw-loader": "^4.0.2",
    "sass": "^1.83.0",
    "sass-loader": "^16.0.4",
    "sass-resources-loader": "^2.2.5",
    "shepherd.js": "~10.0.1",
    "sortablejs": "1.15.x",
    "stylelint": "^16.12.0",
    "stylelint-checkstyle-formatter": "^0.1.2",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-order": "^6.0.4",
    "stylelint-prettier": "^5.0.2",
    "svg-inline-loader": "^0.8.2",
    "svg-spritemap-webpack-plugin": "^4.5.0",
    "tabbable": "~6.0.0",
    "terser": "^5.37.0",
    "terser-webpack-plugin": "^5.3.11",
    "underscore": "~1.13.4",
    "url-loader": "^4.1.1",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-middleware": "^7.4.2",
    "webpack-merge": "^6.0.1",
    "webpack-notifier": "^1.15.0",
    "webpack-remove-empty-scripts": "^1.0.4"
  },
  "browserslist": [
    "last 2 Chrome major versions",
    "last 2 Firefox major versions",
    "last 2 Safari major versions",
    "last 2 Edge major versions",
    "last 2 Opera versions",
    "last 2 iOS major versions",
    "last 1 ChromeAndroid version",
    "last 1 Samsung version",
    "Firefox ESR"
  ],
  "packageManager": "yarn@4.9.3"
}
